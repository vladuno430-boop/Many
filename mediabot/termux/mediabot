#!/data/data/com.termux/files/usr/bin/bash
# MediaBot command installed into $PREFIX/bin by termux/install.sh.
set -euo pipefail

CONFIG_DIR="${HOME}/.config/mediabot"
PROJECT_FILE="${CONFIG_DIR}/project_dir"
SESSION="mediabot"
API_SESSION="mediabot-api"
LOG_DIR="${HOME}/mediabot/logs"
LOG_FILE="${LOG_DIR}/termux-bot.log"
API_LOG_FILE="${LOG_DIR}/termux-api.log"
BRANCH="agent/add-ai-group-chat-hcnsec"

fail() {
    printf '\033[1;31m[x]\033[0m %s\n' "$1" >&2
    exit 1
}

success() {
    printf '\033[1;32m[+]\033[0m %s\n' "$1"
}

info() {
    printf '\033[1;36m==>\033[0m %s\n' "$1"
}

[ -f "${PROJECT_FILE}" ] || fail "MediaBot не установлен. Запусти install-termux.sh."
PROJECT_DIR="$(cat "${PROJECT_FILE}")"
REPO_DIR="$(cd "${PROJECT_DIR}/.." && pwd)"
RUN_SCRIPT="${PROJECT_DIR}/termux/run.sh"

[ -d "${PROJECT_DIR}" ] || fail "Папка проекта не найдена: ${PROJECT_DIR}"
[ -f "${RUN_SCRIPT}" ] || fail "Не найден termux/run.sh"
mkdir -p "${LOG_DIR}"

session_exists() {
    tmux has-session -t "$1" 2>/dev/null
}

start_bot() {
    if session_exists "${SESSION}"; then
        success "Бот уже работает."
        return
    fi

    info "Запускаю бота в фоне..."
    tmux new-session -d -s "${SESSION}" \
        "cd '${PROJECT_DIR}' && bash termux/run.sh 2>&1 | tee -a '${LOG_FILE}'"
    sleep 2

    if session_exists "${SESSION}"; then
        success "Бот запущен и продолжит работать после закрытия Termux."
        echo "Логи: mediabot logs"
        echo "Остановить: mediabot stop"
    else
        echo "Бот завершился при запуске. Последние строки лога:"
        tail -n 40 "${LOG_FILE}" 2>/dev/null || true
        exit 1
    fi
}

stop_bot() {
    if session_exists "${SESSION}"; then
        tmux kill-session -t "${SESSION}"
        success "Бот остановлен."
    else
        info "Бот уже остановлен."
    fi
}

status_bot() {
    if session_exists "${SESSION}"; then
        success "Бот работает."
        tmux list-panes -t "${SESSION}" -F 'Сессия: #{session_name}; запущена: #{session_created_string}' 2>/dev/null || true
    else
        printf '\033[1;33m[-]\033[0m Бот не запущен.\n'
        exit 1
    fi
}

start_api() {
    if session_exists "${API_SESSION}"; then
        success "API и админ-панель уже работают."
        return
    fi
    tmux new-session -d -s "${API_SESSION}" \
        "cd '${PROJECT_DIR}' && bash termux/run.sh api 2>&1 | tee -a '${API_LOG_FILE}'"
    sleep 2
    session_exists "${API_SESSION}" || fail "API завершился. Смотри ${API_LOG_FILE}"
    success "Админ-панель: http://127.0.0.1:8000/admin"
}

stop_api() {
    if session_exists "${API_SESSION}"; then
        tmux kill-session -t "${API_SESSION}"
        success "API остановлен."
    else
        info "API уже остановлен."
    fi
}

update_bot() {
    local was_running=0
    if session_exists "${SESSION}"; then
        was_running=1
        stop_bot
    fi

    info "Обновляю код из GitHub..."
    git -C "${REPO_DIR}" fetch origin "${BRANCH}"
    git -C "${REPO_DIR}" checkout "${BRANCH}"
    git -C "${REPO_DIR}" pull --ff-only origin "${BRANCH}"

    # shellcheck disable=SC1091
    source "${PROJECT_DIR}/.venv/bin/activate"
    cd "${PROJECT_DIR}"
    python -m pip install -e ".[standalone]" --upgrade
    set -a
    # shellcheck disable=SC1091
    source "${PROJECT_DIR}/.env"
    set +a
    alembic upgrade head
    success "Обновление завершено."

    if [ "${was_running}" -eq 1 ]; then
        start_bot
    fi
}

show_help() {
    cat <<'EOF'
MediaBot для Termux

Команды:
  mediabot start       запустить бота в фоне
  mediabot stop        остановить бота
  mediabot restart     перезапустить бота
  mediabot status      проверить состояние
  mediabot logs        смотреть логи в реальном времени
  mediabot attach      открыть консоль запущенного бота
  mediabot update      обновить код, зависимости и базу
  mediabot setup-ai    заменить API-ключ или модель ИИ
  mediabot doctor      диагностика Termux
  mediabot api-start   запустить веб-панель в фоне
  mediabot api-stop    остановить веб-панель
  mediabot help        показать эту справку
EOF
}

COMMAND="${1:-help}"
case "${COMMAND}" in
    start)
        start_bot
        ;;
    stop)
        stop_bot
        ;;
    restart)
        stop_bot
        start_bot
        ;;
    status)
        status_bot
        ;;
    logs)
        touch "${LOG_FILE}"
        tail -n 100 -f "${LOG_FILE}"
        ;;
    attach)
        session_exists "${SESSION}" || fail "Бот не запущен. Сначала: mediabot start"
        tmux attach-session -t "${SESSION}"
        ;;
    update)
        update_bot
        ;;
    setup-ai)
        stop_bot
        bash "${PROJECT_DIR}/termux/configure-ai.sh"
        start_bot
        ;;
    doctor)
        cd "${PROJECT_DIR}"
        bash termux/run.sh doctor
        ;;
    api-start)
        start_api
        ;;
    api-stop)
        stop_api
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        show_help
        fail "Неизвестная команда: ${COMMAND}"
        ;;
esac
