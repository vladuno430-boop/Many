# =============================================================================
# MediaBot — конфигурация для Termux (standalone-режим).
# Файл создаётся автоматически скриптом termux/install.sh.
# =============================================================================

# --- Режим работы ------------------------------------------------------------
# standalone: один процесс, SQLite, кэш в памяти, загрузчик внутри бота.
APP__RUNTIME_MODE=standalone
APP__ENV=local
APP__DEBUG=false
APP__STORAGE_DIR=__DATA_DIR__/storage
APP__TEMP_DIR=__DATA_DIR__/tmp
# На телефоне место дорогое: чистим готовые файлы через 30 минут.
APP__ARTIFACT_TTL_MINUTES=30

# --- Telegram ----------------------------------------------------------------
TELEGRAM__BOT_TOKEN=__BOT_TOKEN__
TELEGRAM__BOT_USERNAME=__BOT_USERNAME__
TELEGRAM__ROOT_ADMIN_IDS=__ADMIN_ID__
# Лимит выгрузки облачного Bot API — 50 МиБ.
TELEGRAM__MAX_UPLOAD_BYTES=52428800

# --- База данных: SQLite вместо PostgreSQL -----------------------------------
DB__BACKEND=sqlite
DB__SQLITE_PATH=__DATA_DIR__/mediabot.db

# --- Redis выключен: кэш, лимиты и FSM живут в памяти процесса ---------------
REDIS__ENABLED=false

# --- Безопасность ------------------------------------------------------------
SECURITY__JWT_SECRET=__JWT_SECRET__
SECURITY__ENCRYPTION_KEY=__FERNET_KEY__
SECURITY__RATE_LIMIT_PER_MINUTE=30
SECURITY__FLOOD_THRESHOLD=8
SECURITY__CAPTCHA_ENABLED=true

# --- Загрузчик ---------------------------------------------------------------
# Телефон — не сервер: две параллельные задачи это уже много.
DOWNLOADER__MAX_CONCURRENT_JOBS=2
DOWNLOADER__JOB_TIMEOUT_SECONDS=1800
DOWNLOADER__MAX_RETRIES=2
DOWNLOADER__FFMPEG_PATH=/data/data/com.termux/files/usr/bin/ffmpeg
DOWNLOADER__FFPROBE_PATH=/data/data/com.termux/files/usr/bin/ffprobe
# Жёсткий потолок размера файла на устройстве.
DOWNLOADER__ABSOLUTE_MAX_FILESIZE_BYTES=2147483648

# --- Платежи -----------------------------------------------------------------
PAYMENTS__CURRENCY=RUB
PAYMENTS__STARS_ENABLED=true
PAYMENTS__CARD_ENABLED=false
PAYMENTS__CRYPTO_ENABLED=false

# --- API и админ-панель (только localhost) -----------------------------------
API__HOST=127.0.0.1
API__PORT=8000
API__DOCS_ENABLED=true
API__ADMIN_USERNAME=admin
API__ADMIN_PASSWORD=__ADMIN_PASSWORD__

# --- Логи --------------------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_DIR=__DATA_DIR__/logs
OBSERVABILITY__LOG_ROTATION=20 MB
OBSERVABILITY__LOG_RETENTION=7 days
OBSERVABILITY__JSON_LOGS=false
