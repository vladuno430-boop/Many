# =============================================================================
# MediaBot — example environment file.
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit the real `.env`; it holds production secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP__ENV=production                 # local | staging | production
# distributed = PostgreSQL + Redis + Celery (this file). Use "standalone" for a
# single-process deployment on SQLite — see TERMUX.md.
APP__RUNTIME_MODE=distributed
APP__DEBUG=false
APP__NAME=MediaBot
APP__TIMEZONE=UTC
# Where finished media files live before they are uploaded to Telegram.
APP__STORAGE_DIR=/var/lib/mediabot/storage
APP__TEMP_DIR=/var/lib/mediabot/tmp
# Delete downloaded artefacts older than N minutes (janitor job).
APP__ARTIFACT_TTL_MINUTES=120

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM__BOT_TOKEN=123456:AAENTER-YOUR-TOKEN-HERE
TELEGRAM__BOT_USERNAME=your_bot
# Comma separated list of Telegram user IDs with root admin rights.
TELEGRAM__ROOT_ADMIN_IDS=111111111,222222222
# Leave empty to use long polling; set to a public https URL to use webhooks.
TELEGRAM__WEBHOOK_URL=
TELEGRAM__WEBHOOK_PATH=/telegram/webhook
TELEGRAM__WEBHOOK_SECRET=change-me-webhook-secret
# Telegram Bot API upload ceiling (bytes). 50 MiB for the cloud API,
# 2 GiB when you self-host a local Bot API server.
TELEGRAM__MAX_UPLOAD_BYTES=52428800
TELEGRAM__API_SERVER=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DB__BACKEND=postgres                # postgres | sqlite
DB__SQLITE_PATH=mediabot.db         # used only when DB__BACKEND=sqlite
DB__HOST=postgres
DB__PORT=5432
DB__NAME=mediabot
DB__USER=mediabot
DB__PASSWORD=change-me-db-password
DB__POOL_SIZE=20
DB__MAX_OVERFLOW=10
DB__ECHO=false

# -----------------------------------------------------------------------------
# Redis (cache + celery broker + rate limiting)
# -----------------------------------------------------------------------------
# Set to false to run without Redis (cache, limits and FSM move in-process).
REDIS__ENABLED=true
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB_CACHE=0
REDIS__DB_BROKER=1
REDIS__DB_RESULT=2
REDIS__DB_FSM=3

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# openssl rand -hex 32
SECURITY__JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long
SECURITY__JWT_ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
SECURITY__REFRESH_TOKEN_TTL_DAYS=14
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY__ENCRYPTION_KEY=
# Static API keys for machine-to-machine access (comma separated).
SECURITY__API_KEYS=
SECURITY__RATE_LIMIT_PER_MINUTE=30
SECURITY__FLOOD_THRESHOLD=8
SECURITY__FLOOD_WINDOW_SECONDS=5
SECURITY__FLOOD_BAN_SECONDS=300
SECURITY__CAPTCHA_ENABLED=true
SECURITY__CAPTCHA_AFTER_VIOLATIONS=3
SECURITY__ALLOWED_ADMIN_ORIGINS=https://admin.example.com

# -----------------------------------------------------------------------------
# Downloader
# -----------------------------------------------------------------------------
DOWNLOADER__MAX_CONCURRENT_JOBS=4
DOWNLOADER__JOB_TIMEOUT_SECONDS=1800
DOWNLOADER__MAX_RETRIES=3
DOWNLOADER__RETRY_BACKOFF_SECONDS=10
DOWNLOADER__FFMPEG_PATH=/usr/bin/ffmpeg
DOWNLOADER__FFPROBE_PATH=/usr/bin/ffprobe
DOWNLOADER__USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
DOWNLOADER__PROXY=
# Optional cookie jar (Netscape format) for age restricted public content.
DOWNLOADER__COOKIES_FILE=
DOWNLOADER__METADATA_CACHE_TTL_SECONDS=1800

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
PAYMENTS__CURRENCY=RUB
PAYMENTS__STARS_ENABLED=true
PAYMENTS__CARD_ENABLED=false
PAYMENTS__CARD_PROVIDER_TOKEN=
PAYMENTS__CRYPTO_ENABLED=false
PAYMENTS__CRYPTO_API_URL=https://pay.crypt.bot/api
PAYMENTS__CRYPTO_API_TOKEN=
PAYMENTS__CRYPTO_ASSET=USDT

# -----------------------------------------------------------------------------
# API / admin web panel
# -----------------------------------------------------------------------------
API__HOST=0.0.0.0
API__PORT=8000
API__ROOT_PATH=
API__DOCS_ENABLED=true
API__CORS_ORIGINS=
# Bootstrap superuser for the web panel (created on first start).
API__ADMIN_USERNAME=admin
API__ADMIN_PASSWORD=change-me-admin-password

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_DIR=/var/log/mediabot
OBSERVABILITY__LOG_ROTATION=100 MB
OBSERVABILITY__LOG_RETENTION=30 days
OBSERVABILITY__JSON_LOGS=true
OBSERVABILITY__METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Referral / economy tuning
# -----------------------------------------------------------------------------
ECONOMY__REFERRAL_BONUS_COINS=50
ECONOMY__REFERRAL_INVITEE_COINS=25
ECONOMY__REFERRAL_PREMIUM_DAYS_PER_5=1
ECONOMY__DAILY_BONUS_COINS=10
ECONOMY__DAILY_STREAK_STEP_COINS=5
ECONOMY__DAILY_STREAK_MAX_COINS=100
ECONOMY__COINS_PER_EXTRA_DOWNLOAD=15
ECONOMY__COINS_PER_PREMIUM_DAY=100
